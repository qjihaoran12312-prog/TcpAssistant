<Window x:Class="TcpAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP 通信助手 · Yvison 适配"
        Height="860" Width="1320" MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ConnectCommand}"/>
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding DisconnectCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearLogCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportLogCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding DetectYvisonCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="230"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.35*" MinHeight="96"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Grid Grid.Row="0" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="30" CornerRadius="2" Background="{StaticResource PrimaryBrush}" Margin="0,0,11,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TCP 通信助手" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Yvison 视觉平台 · 通信适配与联调" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#B6B6C8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKey}" Value="connected">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKey}" Value="listening">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKey}" Value="connecting">
                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button Content="新建" Style="{StaticResource ToolButton}" Command="{Binding AddProfileCommand}"
                        ToolTip="复制当前配置" Margin="4,0,0,0"/>
                <Button Content="删除" Style="{StaticResource ToolButton}" Command="{Binding DeleteProfileCommand}"
                        ToolTip="删除当前配置"/>
                <Button Content="识别端口" Style="{StaticResource GhostButton}" Command="{Binding DetectYvisonCommand}"
                        ToolTip="从 Yvison 自己的配置文件读出端口（Ctrl+E）" Margin="8,0,8,0"/>
                <Button Content="保存配置" Style="{StaticResource GhostButton}" Command="{Binding SaveProfileCommand}"
                        ToolTip="把当前所有配置写回 config\profiles.json"/>
            </StackPanel>
        </Grid>

        <!-- ================= 链路配置 ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,0,20,12" Padding="16,12,16,12">
            <StackPanel>

                <!-- 第一行：连哪儿、以什么身份连 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="配置" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="206" ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="角色" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="148" ItemsSource="{Binding Roles}"
                                      SelectedValuePath="Value" DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedProfile.Role, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="122" FontFamily="Consolas" Text="{Binding SelectedProfile.Host, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="70" FontFamily="Consolas" Text="{Binding SelectedProfile.Port, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="编码" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="88" ItemsSource="{Binding Encodings}"
                                      SelectedItem="{Binding SelectedProfile.Encoding, Mode=TwoWay}"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
                        <Button Content="{Binding AdvancedToggleText}" Style="{StaticResource ToolButton}"
                                Command="{Binding ToggleAdvancedCommand}" Margin="0,0,10,0"
                                ToolTip="展开/收起重连、心跳、超时等设置"/>
                        <Button Content="连接" Width="82" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}" ToolTip="F5"/>
                        <Button Content="断开" Width="68" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding DisconnectCommand}" ToolTip="Shift+F5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,12,0,10"/>

                    <!-- 第二行：怎么切帧、怎么判活、超时多久 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="切帧方式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Width="146" ItemsSource="{Binding FrameModes}"
                                          SelectedValuePath="Value" DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedProfile.FrameMode, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="分隔符" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Width="120" ItemsSource="{Binding Delimiters}"
                                          SelectedItem="{Binding SelectedProfile.Delimiter, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="重连" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="自动" IsChecked="{Binding SelectedProfile.AutoReconnect, Mode=TwoWay}"
                                              Margin="0,0,8,0"/>
                                    <TextBox Width="58" FontFamily="Consolas" Text="{Binding SelectedProfile.ReconnectDelayMs, Mode=TwoWay}"
                                             ToolTip="重连间隔"/>
                                    <TextBlock Text="ms" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="心跳" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="启用" IsChecked="{Binding SelectedProfile.HeartbeatEnabled, Mode=TwoWay}"
                                              Margin="0,0,8,0"/>
                                    <TextBox Width="74" FontFamily="Consolas" Text="{Binding SelectedProfile.HeartbeatText, Mode=TwoWay}"
                                             ToolTip="心跳报文内容"/>
                                    <TextBlock Text="每" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBox Width="56" FontFamily="Consolas" Text="{Binding SelectedProfile.HeartbeatIntervalMs, Mode=TwoWay}"
                                             ToolTip="心跳间隔（毫秒）"/>
                                    <TextBlock Text="ms 连丢" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                    <TextBox Width="40" FontFamily="Consolas" Text="{Binding SelectedProfile.HeartbeatMiss, Mode=TwoWay}"
                                             ToolTip="连续多少次收不到数据判掉线"/>
                                    <TextBlock Text="次" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="回包超时" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="58" FontFamily="Consolas" Text="{Binding ReplyTimeoutText, Mode=TwoWay}"/>
                                    <TextBlock Text="ms" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="连接超时" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="58" FontFamily="Consolas" Text="{Binding SelectedProfile.ConnectTimeoutMs, Mode=TwoWay}"/>
                                    <TextBlock Text="ms" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="230"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- 快捷指令 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource PrimaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="快捷指令" Style="{StaticResource CardTitle}"/>
                        </StackPanel>
                        <TextBlock Text="双击直接发送，单击载入发送区" Style="{StaticResource Hint}" Margin="10,4,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="CommandList"
                             ItemsSource="{Binding SelectedProfile.Commands}"
                             SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                             DisplayMemberPath="Caption"
                             MouseDoubleClick="CommandList_OnMouseDoubleClick"/>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="9,7" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SelectedCommand.Note}" Style="{StaticResource Hint}"
                                   TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16"
                                   ToolTip="{Binding SelectedCommand.Text}"/>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="载入" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                Command="{Binding LoadCommandCommand}"/>
                        <Button Grid.Column="1" Content="发送" Style="{StaticResource PrimaryButton}" Margin="4,0,4,0"
                                Command="{Binding SendSelectedCommand}"/>
                        <Button Grid.Column="2" Content="删除" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Command="{Binding DeleteCommandCommand}"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewCommandName, Mode=TwoWay}"
                                 ToolTip="给发送区内容起个名字"/>
                        <Button Grid.Column="1" Content="存为指令" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding AddCommandCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <!-- 通信记录 + 发送 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12,14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="通信记录" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <TextBlock Text="收 / 发" Style="{StaticResource Hint}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="筛选" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="140" Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按关键字过滤（文本或 HEX 都匹配）" Margin="0,0,12,0"/>
                                <CheckBox Content="HEX" IsChecked="{Binding ShowHex, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <CheckBox Content="暂停滚动" IsChecked="{Binding PauseScroll, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <Rectangle Style="{StaticResource ToolbarSeparator}" Margin="0,0,8,0"/>
                                <Button Content="清空" Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}"
                                        ToolTip="Ctrl+L"/>
                                <Button Content="导出" Style="{StaticResource ToolButton}" Command="{Binding ExportLogCommand}"
                                        ToolTip="Ctrl+S"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#FCFCFE" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}">
                            <RichTextBox x:Name="ReceiveBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Padding="10,8">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="LineHeight" Value="19"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10,14,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="发送" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <CheckBox Content="HEX" IsChecked="{Binding IsHexSend, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <CheckBox Content="追加 CRLF" IsChecked="{Binding AppendCrlf, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <CheckBox Content="等待回包" IsChecked="{Binding ExpectReply, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <CheckBox Content="循环" IsChecked="{Binding IsLooping, Mode=TwoWay}" Margin="0,0,7,0"/>
                                <TextBox Width="56" FontFamily="Consolas" Text="{Binding LoopIntervalText, Mode=TwoWay}"
                                         ToolTip="循环发送间隔（毫秒）"/>
                                <TextBlock Text="ms" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Rectangle Style="{StaticResource ToolbarSeparator}"/>
                                <Button Content="发  送" Width="96" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SendCommand}" ToolTip="Ctrl+Enter"/>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="SendBox" Style="{StaticResource MonoBox}" Height="62"
                                 Text="{Binding SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SendBox_OnKeyDown"/>

                        <Grid Grid.Row="2" Margin="2,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Hint}"
                                       Text="Ctrl+Enter 发送 · 双击日志行可回填 · 支持 \r\n \x41 转义"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Style="{StaticResource MonoCaption}" Text="{Binding SendPreview}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="3" Height="10" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

        <!-- ================= 帧日志 ================= -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="20,0,20,0" Padding="14,10,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="13" CornerRadius="2" Background="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="帧日志" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatsText}" Style="{StaticResource MonoCaption}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="清空" Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}"/>
                        <Button Content="导出" Style="{StaticResource ToolButton}" Command="{Binding ExportLogCommand}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                    <DataGrid x:Name="LogGrid" ItemsSource="{Binding Log.Items}"
                              MouseDoubleClick="LogGrid_OnMouseDoubleClick"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Timeout">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="System">
                                        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Heartbeat">
                                        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="92"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding DirText}" Width="62"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="54"/>
                            <DataGridTextColumn Header="字节" Binding="{Binding Length}" Width="48"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding RttText}" Width="62"/>
                            <DataGridTextColumn Header="内容" Binding="{Binding Preview}" Width="*" ElementStyle="{StaticResource EllipsisCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B6B6C8"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKey}" Value="connected">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="listening">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="connecting">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding NoticeText}" FontSize="11" Margin="18,0,18,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedProfile.Endpoint}" Style="{StaticResource MonoCaption}"/>
                    <Rectangle Style="{StaticResource ToolbarSeparator}" Margin="10,0"/>
                    <TextBlock Text="F5 连接 · Shift+F5 断开" Style="{StaticResource MonoCaption}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
